# Shared by both the FastAPI server (app/) and the model.py worker.
# Copy this file to .env and fill in your real Groq key -- never commit
# a real key to .env.example or to version control.

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=squat_check
# model.py reads the same value as MONGO_DB (kept for its own default)
MONGO_DB=squat_check
GRIDFS_BUCKET=videos

GROQ_API_KEY=groq_api_key_here
GROQ_MODEL=auto

UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/outputs

MAX_VIDEO_SECONDS=60
MAX_UPLOAD_MB=1024
VIDEO_LOOKBACK_SECONDS=60

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL this FastAPI server is reachable at -- model.py uses this to
# build results.video_url after it uploads the annotated video.
BACKEND_BASE_URL=http://localhost:8000
